# @name Test Technique created through Rudder API
# @description This Technique exists only to see if Rudder creates Technique correctly.
# @version 1.0
# @parameter {"name":"technique_parameter","id":"1aaacd71-c2d5-482c-bcff-5eee6f8da9c2","description":" a long description, with line 
#  break within"}

bundle agent technique_by_Rudder(technique_parameter)
{
  vars:
    "resources_dir" string => "${this.promise_dirname}/resources";
  classes:
    "pass3" expression => "pass2";
    "pass2" expression => "pass1";
    "pass1" expression => "any";
  methods:
    "id1_${report_data.directive_id}" usebundle => id1_0("Customized component", "${node.properties[apache_package_name]}", "id1", "${node.properties[apache_package_name]}", "2.2.11"),
                                             if => concat("(debian)");
    "id2_${report_data.directive_id}" usebundle => disable_reporting,
                                             if => concat("(debian.windows)");
    "id2_${report_data.directive_id}" usebundle => id2_1("Command execution", "Write-Host \"testing special characters ` è &é 'à é \"", "id2", "Write-Host \"testing special characters ` è &é 'à é \""),
                                             if => concat("(debian.windows)");
    "id2_${report_data.directive_id}" usebundle => enable_reporting,
                                             if => concat("(debian.windows)");
    "id3_${report_data.directive_id}" usebundle => id3_2("Customized component", "${node.properties[apache_package_name]}", "id3", "${node.properties[apache_package_name]}"),
                                             if => concat("package_install_version_",canonify("${node.properties[apache_package_name]}"),"_repaired");
    "id4_${report_data.directive_id}" usebundle => id4_3("Package install", "openssh-server", "id4", "openssh-server"),
                                             if => concat("redhat");
    "id5_${report_data.directive_id}" usebundle => id5_4("Command execution", "/bin/echo \"testing special characters ` è &é 'à é \"\\", "id5", "/bin/echo \"testing special characters ` è &é 'à é \"\\"),
                                             if => concat("any");
    "id6_${report_data.directive_id}" usebundle => id6_5("Not sure we should test it ...", "NA", "id6", "NA", "NA"),
                                             if => concat("any");

}

bundle agent id1_0(arg_0, arg_1, arg_2, arg_3, arg_4) {
  methods:
    "id1_${report_data.directive_id}" usebundle => _method_reporting_context_v4("${arg_0}","${arg_1}","${arg_2}");
    "id1_${report_data.directive_id}" usebundle => package_install_version("${arg_3}","${arg_4}");

}
bundle agent id2_1(arg_0, arg_1, arg_2, arg_3) {
  methods:
    "id2_${report_data.directive_id}" usebundle => _method_reporting_context_v4("${arg_0}","${arg_1}","${arg_2}");
    "id2_${report_data.directive_id}" usebundle => command_execution("${arg_3}");

}
bundle agent id3_2(arg_0, arg_1, arg_2, arg_3) {
  methods:
    "id3_${report_data.directive_id}" usebundle => _method_reporting_context_v4("${arg_0}","${arg_1}","${arg_2}");
    "id3_${report_data.directive_id}" usebundle => service_start("${arg_3}");

}
bundle agent id4_3(arg_0, arg_1, arg_2, arg_3) {
  methods:
    "id4_${report_data.directive_id}" usebundle => _method_reporting_context_v4("${arg_0}","${arg_1}","${arg_2}");
    "id4_${report_data.directive_id}" usebundle => package_install("${arg_3}");

}
bundle agent id5_4(arg_0, arg_1, arg_2, arg_3) {
  methods:
    "id5_${report_data.directive_id}" usebundle => _method_reporting_context_v4("${arg_0}","${arg_1}","${arg_2}");
    "id5_${report_data.directive_id}" usebundle => command_execution("${arg_3}");

}
bundle agent id6_5(arg_0, arg_1, arg_2, arg_3, arg_4) {
  methods:
    "id6_${report_data.directive_id}" usebundle => _method_reporting_context_v4("${arg_0}","${arg_1}","${arg_2}");
    "id6_${report_data.directive_id}" usebundle => _logger("${arg_3}","${arg_4}");

}
